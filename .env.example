# Public metadata/canonical URL
NUXT_PUBLIC_SITE_URL=https://keithpotter.net
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Private contact-delivery configuration. Never expose or commit real values.
GOOGLE_FORM_ENDPOINT=
GOOGLE_FORM_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Koded by Keith <hello@send.keithpotter.net>"
CONTACT_NOTIFICATION_EMAIL=hello@keithpotter.net
CONTACT_RATE_LIMIT=5

# Private spam-protection configuration. Generate CONTACT_FORM_SIGNING_SECRET
# with: openssl rand -hex 32
TURNSTILE_SECRET_KEY=
CONTACT_FORM_SIGNING_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=keithpotter.net,www.keithpotter.net
CONTACT_FORM_MIN_SECONDS=3
CONTACT_FORM_MAX_SECONDS=1800
CONTACT_DUPLICATE_WINDOW_SECONDS=900
